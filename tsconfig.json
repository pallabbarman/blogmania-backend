{
    "compilerOptions": {
        "module": "esnext",
        "target": "es5",
        "rootDir": "./src",
        "outDir": "./dist",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "ignoreDeprecations": "6.0",
        "types": ["node"],
        "strict": true,
        "skipLibCheck": true,
        "strictNullChecks": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "paths": {
            "configs/*": ["./src/configs/*"],
            "generated/*": ["./src/generated/*"],
            "errors/*": ["./src/errors/*"],
            "middlewares/*": ["./src/middlewares/*"],
            "modules/*": ["./src/modules/*"],
            "routes/*": ["./src/routes/*"],
            "types/*": ["./src/types/*"],
            "utils/*": ["./src/utils/*"]
        }
    },
    "include": ["src/**/*", "index.d.ts"],
    "exclude": ["node_modules", "logs", "dist"]
}
